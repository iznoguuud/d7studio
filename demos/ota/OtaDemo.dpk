package OtaDemo;

{ D7 Studio's Open Tools API demo: an IDE expert in a design-time package (OtaDemoWizard) with a
  dockable tool window (OtaDemoWin). }

{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO ON}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS ON}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO ON}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'D7 Studio Open Tools API demo'}
{$DESIGNONLY}
{$IMPLICITBUILD OFF}

requires
  rtl,
  vcl,
  designide;

contains
  OtaDemoWizard in 'OtaDemoWizard.pas',
  OtaDemoCreators in 'OtaDemoCreators.pas',
  OtaDemoWin in 'OtaDemoWin.pas' {OtaDemoWindow},
  OtaDemoTest in 'OtaDemoTest.pas',
  OtaDemoTestIde in 'OtaDemoTestIde.pas',
  OtaDemoTestGroup in 'OtaDemoTestGroup.pas',
  OtaDemoTestEdit in 'OtaDemoTestEdit.pas',
  OtaDemoTestBlock in 'OtaDemoTestBlock.pas',
  OtaDemoTestForm in 'OtaDemoTestForm.pas',
  OtaDemoTestKeys in 'OtaDemoTestKeys.pas',
  OtaDemoTestDebug in 'OtaDemoTestDebug.pas',
  OtaDemoToDo in 'OtaDemoToDo.pas',
  OtaDemoCodeInsight in 'OtaDemoCodeInsight.pas',
  OtaDemoTestToDo in 'OtaDemoTestToDo.pas',
  OtaDemoTestCodeInsight in 'OtaDemoTestCodeInsight.pas',
  OtaDemoServices2 in 'OtaDemoServices2.pas',
  OtaDemoTestServices2 in 'OtaDemoTestServices2.pas';

end.
