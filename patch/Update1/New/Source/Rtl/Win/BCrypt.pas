{ ---- helpers ---- }

function BCryptSetStringProperty(hObject: BCRYPT_HANDLE; pszProperty,
  Value: PWideChar): NTSTATUS;
begin
  if Value = nil then
    Result := BCryptSetProperty(hObject, pszProperty, nil, 0, 0)
  else
    Result := BCryptSetProperty(hObject, pszProperty, PUCHAR(Value),
      (lstrlenW(Value) + 1) * SizeOf(WideChar), 0);
end;

{ Hash (Hmac = False) or HMAC of DataSize bytes at Data. The hash object is
  allocated here (BCRYPT_OBJECT_LENGTH), as Windows Vista requires. }
function HashOrHmac(AlgId: PWideChar; Hmac: Boolean; Key: Pointer; KeySize: Cardinal;
  Data: Pointer; DataSize: Cardinal; out Digest: string): NTSTATUS;
var
  Alg: BCRYPT_ALG_HANDLE;
  Hash: BCRYPT_HASH_HANDLE;
  ObjectLength, HashLength, Got, Flags: ULONG;
  HashObject: Pointer;
begin
  Digest := '';
  if Hmac then
    Flags := BCRYPT_ALG_HANDLE_HMAC_FLAG
  else
    Flags := 0;
  Result := BCryptOpenAlgorithmProvider(Alg, AlgId, nil, Flags);
  if Result < 0 then
    Exit;
  HashObject := nil;
  try
    Result := BCryptGetProperty(Alg, BCRYPT_OBJECT_LENGTH, @ObjectLength,
      SizeOf(ObjectLength), Got, 0);
    if Result < 0 then
      Exit;
    Result := BCryptGetProperty(Alg, BCRYPT_HASH_LENGTH, @HashLength,
      SizeOf(HashLength), Got, 0);
    if Result < 0 then
      Exit;
    GetMem(HashObject, ObjectLength);
    Result := BCryptCreateHash(Alg, Hash, HashObject, ObjectLength, Key, KeySize, 0);
    if Result < 0 then
      Exit;
    try
      if DataSize > 0 then
        Result := BCryptHashData(Hash, Data, DataSize, 0);
      if Result >= 0 then
      begin
        SetLength(Digest, HashLength);
        Result := BCryptFinishHash(Hash, Pointer(Digest), HashLength, 0);
        if Result < 0 then
          Digest := '';
      end;
    finally
      BCryptDestroyHash(Hash);
    end;
  finally
    if HashObject <> nil then
      FreeMem(HashObject);
    BCryptCloseAlgorithmProvider(Alg, 0);
  end;
end;

function BCryptHashBuffer(AlgId: PWideChar; const Data; Size: Cardinal;
  out Digest: string): NTSTATUS;
begin
  Result := HashOrHmac(AlgId, False, nil, 0, @Data, Size, Digest);
end;

function BCryptHmacBuffer(AlgId: PWideChar; const Key; KeySize: Cardinal;
  const Data; Size: Cardinal; out Digest: string): NTSTATUS;
begin
  Result := HashOrHmac(AlgId, True, @Key, KeySize, @Data, Size, Digest);
end;

function BCryptHashString(AlgId: PWideChar; const S: string): string;
const
  HexDigits: array[0..15] of Char = '0123456789abcdef';
var
  Digest: string;
  I: Integer;
begin
  Result := '';
  if HashOrHmac(AlgId, False, nil, 0, Pointer(S), Length(S), Digest) >= 0 then
  begin
    SetLength(Result, 2 * Length(Digest));
    for I := 1 to Length(Digest) do
    begin
      Result[2 * I - 1] := HexDigits[Ord(Digest[I]) shr 4];
      Result[2 * I] := HexDigits[Ord(Digest[I]) and $F];
    end;
  end;
end;

function BCryptRandomBytes(var Buffer; Size: Cardinal): NTSTATUS;
var
  Alg: BCRYPT_ALG_HANDLE;
begin
  if Size = 0 then
  begin
    Result := STATUS_SUCCESS;
    Exit;
  end;
  Result := BCryptGenRandom(nil, @Buffer, Size, BCRYPT_USE_SYSTEM_PREFERRED_RNG);
  if (Result < 0) and (Result <> STATUS_NOT_IMPLEMENTED) then
    { Windows Vista has no system-preferred RNG: use an RNG provider }
    if BCryptOpenAlgorithmProvider(Alg, BCRYPT_RNG_ALGORITHM, nil, 0) >= 0 then
    begin
      Result := BCryptGenRandom(Alg, @Buffer, Size, 0);
      BCryptCloseAlgorithmProvider(Alg, 0);
    end;
end;

