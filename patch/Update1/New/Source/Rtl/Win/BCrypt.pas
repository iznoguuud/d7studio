begin
  if GetBCryptProc(BCryptGenerateSymmetricKeyProc, 'BCryptGenerateSymmetricKey') then
    Result := TBCryptGenerateSymmetricKeyFn(BCryptGenerateSymmetricKeyProc)(hAlgorithm,
      phKey, pbKeyObject, cbKeyObject, pbSecret, cbSecret, dwFlags)
  else
  begin
    phKey := nil;
    Result := STATUS_NOT_IMPLEMENTED;
  end;
end;

function BCryptGenerateKeyPair(hAlgorithm: BCRYPT_ALG_HANDLE;
  out phKey: BCRYPT_KEY_HANDLE; dwLength: ULONG; dwFlags: ULONG): NTSTATUS; stdcall;
begin
  if GetBCryptProc(BCryptGenerateKeyPairProc, 'BCryptGenerateKeyPair') then
    Result := TBCryptGenerateKeyPairFn(BCryptGenerateKeyPairProc)(hAlgorithm, phKey,
      dwLength, dwFlags)
  else
  begin
    phKey := nil;
    Result := STATUS_NOT_IMPLEMENTED;
  end;
end;

function BCryptEncrypt(hKey: BCRYPT_KEY_HANDLE; pbInput: PUCHAR; cbInput: ULONG;
