  cbOutput: ULONG; out pcbResult: ULONG; dwFlags: ULONG): NTSTATUS; stdcall;
begin
  if GetBCryptProc(BCryptEncryptProc, 'BCryptEncrypt') then
    Result := TBCryptCipherFn(BCryptEncryptProc)(hKey, pbInput, cbInput, pPaddingInfo,
      pbIV, cbIV, pbOutput, cbOutput, pcbResult, dwFlags)
  else
  begin
    pcbResult := 0;
    Result := STATUS_NOT_IMPLEMENTED;
  end;
end;

function BCryptDecrypt(hKey: BCRYPT_KEY_HANDLE; pbInput: PUCHAR; cbInput: ULONG;
  pPaddingInfo: Pointer; pbIV: PUCHAR; cbIV: ULONG; pbOutput: PUCHAR;
  cbOutput: ULONG; out pcbResult: ULONG; dwFlags: ULONG): NTSTATUS; stdcall;
begin
  if GetBCryptProc(BCryptDecryptProc, 'BCryptDecrypt') then
    Result := TBCryptCipherFn(BCryptDecryptProc)(hKey, pbInput, cbInput, pPaddingInfo,
      pbIV, cbIV, pbOutput, cbOutput, pcbResult, dwFlags)
  else
  begin
    pcbResult := 0;
    Result := STATUS_NOT_IMPLEMENTED;
  end;
end;

function BCryptExportKey(hKey: BCRYPT_KEY_HANDLE; hExportKey: BCRYPT_KEY_HANDLE;
