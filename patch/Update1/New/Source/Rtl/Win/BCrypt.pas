{ ====== Helpers (not in the SDK) =========================================== }

{ BCryptSetProperty with a string value (BCRYPT_CHAINING_MODE =
  BCRYPT_CHAIN_MODE_GCM ...): passes Value with its terminating null
  character. }
function BCryptSetStringProperty(hObject: BCRYPT_HANDLE; pszProperty,
  Value: PWideChar): NTSTATUS;

{ Digest of Size bytes at Data with the hash algorithm AlgId
  (BCRYPT_SHA256_ALGORITHM ...). Digest receives the raw digest bytes, ''
  on failure. Runs on Windows Vista (allocates the hash object itself).
  Returns the first failing NTSTATUS. }
function BCryptHashBuffer(AlgId: PWideChar; const Data; Size: Cardinal;
  out Digest: string): NTSTATUS;

{ HMAC of Size bytes at Data with the hash algorithm AlgId and KeySize
  bytes of key at Key (KeySize may be 0). Digest as BCryptHashBuffer. }
function BCryptHmacBuffer(AlgId: PWideChar; const Key; KeySize: Cardinal;
  const Data; Size: Cardinal; out Digest: string): NTSTATUS;

{ Lowercase hexadecimal digest of the bytes of S, e.g.
  BCryptHashString(BCRYPT_SHA256_ALGORITHM, 'abc'); '' when the algorithm
  or bcrypt.dll is not available. }
function BCryptHashString(AlgId: PWideChar; const S: string): string;

{ Fills Size bytes at Buffer with cryptographically random bytes: the
  system-preferred RNG (Windows 7 and later), else an RNG provider (Windows
  Vista). }
function BCryptRandomBytes(var Buffer; Size: Cardinal): NTSTATUS;

{$IFDEF BCRYPT_TESTFALLBACKS}
{ Test builds only (compile with -DBCRYPT_TESTFALLBACKS): when True, every
  function behaves as if bcrypt.dll were missing, also after earlier
  successful calls. }
var
  BCryptSimulateMissing: Boolean;
{$ENDIF}

implementation

{ ---- run-time binding ---- }

const
  bcryptlib = 'bcrypt.dll';

var
  BCryptModule: HMODULE;
  BCryptLoaded: Boolean;
  BCryptOpenAlgorithmProviderProc: Pointer;
  BCryptEnumAlgorithmsProc: Pointer;
  BCryptEnumProvidersProc: Pointer;
  BCryptGetPropertyProc: Pointer;
  BCryptSetPropertyProc: Pointer;
  BCryptCloseAlgorithmProviderProc: Pointer;
  BCryptFreeBufferProc: Pointer;
  BCryptGenerateSymmetricKeyProc: Pointer;
  BCryptGenerateKeyPairProc: Pointer;
  BCryptEncryptProc: Pointer;
  BCryptDecryptProc: Pointer;
  BCryptExportKeyProc: Pointer;
  BCryptImportKeyProc: Pointer;
  BCryptImportKeyPairProc: Pointer;
  BCryptDuplicateKeyProc: Pointer;
  BCryptFinalizeKeyPairProc: Pointer;
  BCryptDestroyKeyProc: Pointer;
  BCryptDestroySecretProc: Pointer;
  BCryptSignHashProc: Pointer;
  BCryptVerifySignatureProc: Pointer;
  BCryptSecretAgreementProc: Pointer;
  BCryptDeriveKeyProc: Pointer;
  BCryptKeyDerivationProc: Pointer;
  BCryptCreateHashProc: Pointer;
  BCryptHashDataProc: Pointer;
  BCryptFinishHashProc: Pointer;
  BCryptCreateMultiHashProc: Pointer;
  BCryptProcessMultiOperationsProc: Pointer;
  BCryptDuplicateHashProc: Pointer;
  BCryptDestroyHashProc: Pointer;
  BCryptHashProc: Pointer;
  BCryptGenRandomProc: Pointer;
  BCryptDeriveKeyCapiProc: Pointer;
  BCryptDeriveKeyPBKDF2Proc: Pointer;
  BCryptGetFipsAlgorithmModeProc: Pointer;

type
  TBCryptOpenAlgorithmProviderFn = function(out phAlgorithm: BCRYPT_ALG_HANDLE;
    pszAlgId: PWideChar; pszImplementation: PWideChar; dwFlags: ULONG): NTSTATUS; stdcall;
  TBCryptEnumAlgorithmsFn = function(dwAlgOperations: ULONG; out pAlgCount: ULONG;
    out ppAlgList: PBCryptAlgorithmIdentifier; dwFlags: ULONG): NTSTATUS; stdcall;
  TBCryptEnumProvidersFn = function(pszAlgId: PWideChar; out pImplCount: ULONG;
    out ppImplList: PBCryptProviderName; dwFlags: ULONG): NTSTATUS; stdcall;
  TBCryptGetPropertyFn = function(hObject: BCRYPT_HANDLE; pszProperty: PWideChar;
    pbOutput: PUCHAR; cbOutput: ULONG; out pcbResult: ULONG; dwFlags: ULONG): NTSTATUS; stdcall;
  TBCryptSetPropertyFn = function(hObject: BCRYPT_HANDLE; pszProperty: PWideChar;
    pbInput: PUCHAR; cbInput: ULONG; dwFlags: ULONG): NTSTATUS; stdcall;
  TBCryptHandleFlagsFn = function(h: Pointer; dwFlags: ULONG): NTSTATUS; stdcall;
  TBCryptHandleFn = function(h: Pointer): NTSTATUS; stdcall;
  TBCryptFreeBufferFn = procedure(pvBuffer: Pointer); stdcall;
  TBCryptGenerateSymmetricKeyFn = function(hAlgorithm: BCRYPT_ALG_HANDLE;
    out phKey: BCRYPT_KEY_HANDLE; pbKeyObject: PUCHAR; cbKeyObject: ULONG;
    pbSecret: PUCHAR; cbSecret: ULONG; dwFlags: ULONG): NTSTATUS; stdcall;
  TBCryptGenerateKeyPairFn = function(hAlgorithm: BCRYPT_ALG_HANDLE;
    out phKey: BCRYPT_KEY_HANDLE; dwLength: ULONG; dwFlags: ULONG): NTSTATUS; stdcall;
  TBCryptCipherFn = function(hKey: BCRYPT_KEY_HANDLE; pbInput: PUCHAR; cbInput: ULONG;
    pPaddingInfo: Pointer; pbIV: PUCHAR; cbIV: ULONG; pbOutput: PUCHAR;
    cbOutput: ULONG; out pcbResult: ULONG; dwFlags: ULONG): NTSTATUS; stdcall;
  TBCryptExportKeyFn = function(hKey: BCRYPT_KEY_HANDLE; hExportKey: BCRYPT_KEY_HANDLE;
    pszBlobType: PWideChar; pbOutput: PUCHAR; cbOutput: ULONG;
    out pcbResult: ULONG; dwFlags: ULONG): NTSTATUS; stdcall;
  TBCryptImportKeyFn = function(hAlgorithm: BCRYPT_ALG_HANDLE; hImportKey: BCRYPT_KEY_HANDLE;
    pszBlobType: PWideChar; out phKey: BCRYPT_KEY_HANDLE; pbKeyObject: PUCHAR;
    cbKeyObject: ULONG; pbInput: PUCHAR; cbInput: ULONG; dwFlags: ULONG): NTSTATUS; stdcall;
  TBCryptImportKeyPairFn = function(hAlgorithm: BCRYPT_ALG_HANDLE; hImportKey: BCRYPT_KEY_HANDLE;
    pszBlobType: PWideChar; out phKey: BCRYPT_KEY_HANDLE; pbInput: PUCHAR;
    cbInput: ULONG; dwFlags: ULONG): NTSTATUS; stdcall;
  TBCryptDuplicateFn = function(hSource: Pointer; out phNew: Pointer;
    pbObject: PUCHAR; cbObject: ULONG; dwFlags: ULONG): NTSTATUS; stdcall;
  TBCryptSignHashFn = function(hKey: BCRYPT_KEY_HANDLE; pPaddingInfo: Pointer;
    pbInput: PUCHAR; cbInput: ULONG; pbOutput: PUCHAR; cbOutput: ULONG;
    out pcbResult: ULONG; dwFlags: ULONG): NTSTATUS; stdcall;
  TBCryptVerifySignatureFn = function(hKey: BCRYPT_KEY_HANDLE; pPaddingInfo: Pointer;
    pbHash: PUCHAR; cbHash: ULONG; pbSignature: PUCHAR; cbSignature: ULONG;
    dwFlags: ULONG): NTSTATUS; stdcall;
  TBCryptSecretAgreementFn = function(hPrivKey: BCRYPT_KEY_HANDLE; hPubKey: BCRYPT_KEY_HANDLE;
    out phAgreedSecret: BCRYPT_SECRET_HANDLE; dwFlags: ULONG): NTSTATUS; stdcall;
  TBCryptDeriveKeyFn = function(hSharedSecret: BCRYPT_SECRET_HANDLE; pwszKDF: PWideChar;
    pParameterList: PBCryptBufferDesc; pbDerivedKey: PUCHAR; cbDerivedKey: ULONG;
    out pcbResult: ULONG; dwFlags: ULONG): NTSTATUS; stdcall;
  TBCryptKeyDerivationFn = function(hKey: BCRYPT_KEY_HANDLE; pParameterList: PBCryptBufferDesc;
    pbDerivedKey: PUCHAR; cbDerivedKey: ULONG; out pcbResult: ULONG;
    dwFlags: ULONG): NTSTATUS; stdcall;
  TBCryptCreateHashFn = function(hAlgorithm: BCRYPT_ALG_HANDLE; out phHash: BCRYPT_HASH_HANDLE;
    pbHashObject: PUCHAR; cbHashObject: ULONG; pbSecret: PUCHAR; cbSecret: ULONG;
    dwFlags: ULONG): NTSTATUS; stdcall;
  TBCryptHashBufferFn = function(hHash: BCRYPT_HASH_HANDLE; pbBuffer: PUCHAR;
    cbBuffer: ULONG; dwFlags: ULONG): NTSTATUS; stdcall;
  TBCryptCreateMultiHashFn = function(hAlgorithm: BCRYPT_ALG_HANDLE;
    out phHash: BCRYPT_HASH_HANDLE; nHashes: ULONG; pbHashObject: PUCHAR;
    cbHashObject: ULONG; pbSecret: PUCHAR; cbSecret: ULONG; dwFlags: ULONG): NTSTATUS; stdcall;
  TBCryptProcessMultiOperationsFn = function(hObject: BCRYPT_HANDLE;
    operationType: BCRYPT_MULTI_OPERATION_TYPE; pOperations: Pointer;
    cbOperations: ULONG; dwFlags: ULONG): NTSTATUS; stdcall;
  TBCryptHashFn = function(hAlgorithm: BCRYPT_ALG_HANDLE; pbSecret: PUCHAR; cbSecret: ULONG;
    pbInput: PUCHAR; cbInput: ULONG; pbOutput: PUCHAR; cbOutput: ULONG): NTSTATUS; stdcall;
  TBCryptDeriveKeyCapiFn = function(hHash: BCRYPT_HASH_HANDLE; hTargetAlg: BCRYPT_ALG_HANDLE;
    pbDerivedKey: PUCHAR; cbDerivedKey: ULONG; dwFlags: ULONG): NTSTATUS; stdcall;
  TBCryptDeriveKeyPBKDF2Fn = function(hPrf: BCRYPT_ALG_HANDLE; pbPassword: PUCHAR;
    cbPassword: ULONG; pbSalt: PUCHAR; cbSalt: ULONG; cIterations: ULONGLONG;
    pbDerivedKey: PUCHAR; cbDerivedKey: ULONG; dwFlags: ULONG): NTSTATUS; stdcall;
  TBCryptGetFipsAlgorithmModeFn = function(out pfEnabled: ByteBool): NTSTATUS; stdcall;

{ bcrypt.dll is loaded once, by full path from the system directory, and
  never released. A missing DLL is remembered; a function pointer is cached
  once found. Concurrent first calls at worst load the DLL twice (one more
  reference) and look up the same pointer twice. }
function GetBCryptProc(var Proc: Pointer; Name: PChar): Boolean;
var
  Path: array[0..MAX_PATH + 16] of Char;
  Len: UINT;
begin
  {$IFDEF BCRYPT_TESTFALLBACKS}
  if BCryptSimulateMissing then
  begin
    Result := False;
    Exit;
  end;
  {$ENDIF}
  if Proc = nil then
  begin
    if not BCryptLoaded then
    begin
      Len := GetSystemDirectory(Path, MAX_PATH);
      if (Len > 0) and (Len < MAX_PATH) then
      begin
        lstrcat(Path, '\' + bcryptlib);
        BCryptModule := LoadLibrary(Path);
      end;
      BCryptLoaded := True;
    end;
    if BCryptModule <> 0 then
      Proc := GetProcAddress(BCryptModule, Name);
  end;
  Result := Proc <> nil;
end;

{ ---- NTSTATUS / structure macros ---- }

function BCRYPT_SUCCESS(Status: NTSTATUS): Boolean;
begin
  Result := Status >= 0;
end;

procedure BCRYPT_INIT_AUTH_MODE_INFO(var AuthInfo: TBCryptAuthenticatedCipherModeInfo);
begin
  FillChar(AuthInfo, SizeOf(AuthInfo), 0);
  AuthInfo.cbSize := SizeOf(AuthInfo);
  AuthInfo.dwInfoVersion := BCRYPT_AUTHENTICATED_CIPHER_MODE_INFO_VERSION;
end;

{ ---- algorithm providers ---- }

function BCryptOpenAlgorithmProvider(out phAlgorithm: BCRYPT_ALG_HANDLE;
  pszAlgId: PWideChar; pszImplementation: PWideChar; dwFlags: ULONG): NTSTATUS; stdcall;
begin
  if GetBCryptProc(BCryptOpenAlgorithmProviderProc, 'BCryptOpenAlgorithmProvider') then
    Result := TBCryptOpenAlgorithmProviderFn(BCryptOpenAlgorithmProviderProc)(phAlgorithm,
      pszAlgId, pszImplementation, dwFlags)
  else
  begin
    phAlgorithm := nil;
    Result := STATUS_NOT_IMPLEMENTED;
  end;
end;

function BCryptEnumAlgorithms(dwAlgOperations: ULONG; out pAlgCount: ULONG;
  out ppAlgList: PBCryptAlgorithmIdentifier; dwFlags: ULONG): NTSTATUS; stdcall;
begin
  if GetBCryptProc(BCryptEnumAlgorithmsProc, 'BCryptEnumAlgorithms') then
    Result := TBCryptEnumAlgorithmsFn(BCryptEnumAlgorithmsProc)(dwAlgOperations,
      pAlgCount, ppAlgList, dwFlags)
  else
  begin
    pAlgCount := 0;
    ppAlgList := nil;
    Result := STATUS_NOT_IMPLEMENTED;
  end;
end;

function BCryptEnumProviders(pszAlgId: PWideChar; out pImplCount: ULONG;
  out ppImplList: PBCryptProviderName; dwFlags: ULONG): NTSTATUS; stdcall;
begin
  if GetBCryptProc(BCryptEnumProvidersProc, 'BCryptEnumProviders') then
    Result := TBCryptEnumProvidersFn(BCryptEnumProvidersProc)(pszAlgId, pImplCount,
      ppImplList, dwFlags)
  else
  begin
    pImplCount := 0;
    ppImplList := nil;
    Result := STATUS_NOT_IMPLEMENTED;
  end;
end;

function BCryptGetProperty(hObject: BCRYPT_HANDLE; pszProperty: PWideChar;
  pbOutput: PUCHAR; cbOutput: ULONG; out pcbResult: ULONG; dwFlags: ULONG): NTSTATUS; stdcall;
begin
  if GetBCryptProc(BCryptGetPropertyProc, 'BCryptGetProperty') then
    Result := TBCryptGetPropertyFn(BCryptGetPropertyProc)(hObject, pszProperty,
      pbOutput, cbOutput, pcbResult, dwFlags)
  else
  begin
    pcbResult := 0;
    Result := STATUS_NOT_IMPLEMENTED;
  end;
end;

function BCryptSetProperty(hObject: BCRYPT_HANDLE; pszProperty: PWideChar;
  pbInput: PUCHAR; cbInput: ULONG; dwFlags: ULONG): NTSTATUS; stdcall;
begin
  if GetBCryptProc(BCryptSetPropertyProc, 'BCryptSetProperty') then
    Result := TBCryptSetPropertyFn(BCryptSetPropertyProc)(hObject, pszProperty,
      pbInput, cbInput, dwFlags)
  else
    Result := STATUS_NOT_IMPLEMENTED;
end;

function BCryptCloseAlgorithmProvider(hAlgorithm: BCRYPT_ALG_HANDLE;
  dwFlags: ULONG): NTSTATUS; stdcall;
begin
  if GetBCryptProc(BCryptCloseAlgorithmProviderProc, 'BCryptCloseAlgorithmProvider') then
    Result := TBCryptHandleFlagsFn(BCryptCloseAlgorithmProviderProc)(hAlgorithm, dwFlags)
  else
    Result := STATUS_NOT_IMPLEMENTED;
end;

procedure BCryptFreeBuffer(pvBuffer: Pointer); stdcall;
begin
  if GetBCryptProc(BCryptFreeBufferProc, 'BCryptFreeBuffer') then
    TBCryptFreeBufferFn(BCryptFreeBufferProc)(pvBuffer);
end;

{ ---- keys and encryption ---- }

