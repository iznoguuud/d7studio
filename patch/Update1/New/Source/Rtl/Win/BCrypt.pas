  out pcbResult: ULONG; dwFlags: ULONG): NTSTATUS; stdcall;
begin
  if GetBCryptProc(BCryptExportKeyProc, 'BCryptExportKey') then
    Result := TBCryptExportKeyFn(BCryptExportKeyProc)(hKey, hExportKey, pszBlobType,
