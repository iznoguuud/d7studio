{ powrprof.dll is loaded once, from the system directory only (it is not a
  known DLL, so this avoids search-order planting), and never released. A
  missing DLL is remembered; a function pointer is cached once found. }
function GetPowrProfProc(var Proc: Pointer; Name: PChar): Boolean;
var
  Path: array[0..MAX_PATH + 16] of Char;
  Len: UINT;
begin
  if Proc = nil then
  begin
    if not PowrProfLoaded then
    begin
      Len := GetSystemDirectory(Path, MAX_PATH);
      if (Len > 0) and (Len < MAX_PATH) then
      begin
        lstrcat(Path, '\' + powrproflib);
        PowrProfModule := LoadLibrary(Path);
      end;
      PowrProfLoaded := True;
    end;
    if PowrProfModule <> 0 then
      Proc := GetProcAddress(PowrProfModule, Name);
  end;
  Result := Proc <> nil;
end;

function PowerGetActiveScheme(UserRootPowerKey: HKEY; var ActivePolicyGuid: PGUID): DWORD; stdcall;
begin
  if GetPowrProfProc(PowerGetActiveSchemeProc, 'PowerGetActiveScheme') then
    Result := TPowerKeyPtrFn(PowerGetActiveSchemeProc)(UserRootPowerKey, @ActivePolicyGuid)
  else
  begin
    ActivePolicyGuid := nil;
    Result := ERROR_CALL_NOT_IMPLEMENTED;
  end;
end;

